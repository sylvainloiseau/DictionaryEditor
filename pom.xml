<?xml version="1.0" encoding="UTF-8" ?>
<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
>
  <modelVersion>4.0.0</modelVersion>

  <groupId>fr.cnrs.lacito</groupId>
  <artifactId>DictionaryEditor</artifactId>
  <version>0.1-SNAPSHOT</version>

  <name>DictionaryEditor</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <javafx.version>25</javafx.version>
    <maven-jlink-plugin.version>3.3.0</maven-jlink-plugin.version>
    <jpackage-maven-plugin.version>1.6.6</jpackage-maven-plugin.version>
    <jpackage.type>DEB</jpackage.type>
    <jpackage.destSuffix />
    <app.jpackage.name>DictionaryEditor</app.jpackage.name>
    <!-- Installer icon; the os-mac and os-windows profiles switch to .icns and .ico. -->
    <jpackage.icon>${project.basedir}/src/main/jpackage/DictionaryEditor.png</jpackage.icon>
    <!-- UI tests: headless (Monocle) by default; -Dheadless=false -Dglass.platform= shows the windows. -->
    <headless>true</headless>
    <glass.platform>Monocle</glass.platform>
    <!-- The release of lift-api on Maven Central. To build against a lift-api installed
         locally (mvn install in lift-api): -Dlift-api.version=0.1-SNAPSHOT -->
    <lift-api.version>0.1.0</lift-api.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.sylvainloiseau</groupId>
      <artifactId>lift-api</artifactId>
      <version>${lift-api.version}</version>
    </dependency>

    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-core</artifactId>
      <version>4.0.18</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-junit5</artifactId>
      <version>4.0.18</version>
      <scope>test</scope>
    </dependency>
    <!-- Headless JavaFX for the UI tests (see the surefire configuration). -->
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>openjfx-monocle</artifactId>
      <version>21.0.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
          <configuration>
            <!-- TestFX and Monocle are not modules: the tests run on the class path. -->
            <useModulePath>false</useModulePath>
            <systemPropertyVariables>
              <!-- The tests never read or write the user's preferences (recent files…). -->
              <java.util.prefs.PreferencesFactory>fr.cnrs.lacito.liftgui.testsupport.InMemoryPreferences$Factory</java.util.prefs.PreferencesFactory>
              <!-- Headless UI tests; run with -Dheadless=false to watch them. -->
              <testfx.robot>glass</testfx.robot>
              <testfx.headless>${headless}</testfx.headless>
              <glass.platform>${glass.platform}</glass.platform>
              <monocle.platform>Headless</monocle.platform>
              <!-- The virtual screen must be larger than the test window (1400x900). -->
              <headless.geometry>1920x1200-32</headless.geometry>
              <prism.order>sw</prism.order>
              <prism.text>t2k</prism.text>
              <java.awt.headless>true</java.awt.headless>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jlink-plugin</artifactId>
          <version>${maven-jlink-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.panteleyev</groupId>
          <artifactId>jpackage-maven-plugin</artifactId>
          <version>${jpackage-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass
                    >fr.cnrs.lacito.liftgui/fr.cnrs.lacito.liftgui.MainApp</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- The installer icon in the format each system expects (see jpackage.icon). -->
    <profile>
      <id>os-mac</id>
      <activation><os><family>mac</family></os></activation>
      <properties>
        <jpackage.icon>${project.basedir}/src/main/jpackage/DictionaryEditor.icns</jpackage.icon>
      </properties>
    </profile>
    <profile>
      <id>os-windows</id>
      <activation><os><family>windows</family></os></activation>
      <properties>
        <jpackage.icon>${project.basedir}/src/main/jpackage/DictionaryEditor.ico</jpackage.icon>
      </properties>
    </profile>
    <profile>
      <id>dist</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jlink-plugin</artifactId>
            <executions>
              <execution>
                <id>custom-runtime</id>
                <goals>
                  <goal>jlink</goal>
                </goals>
                <configuration>
                  <attach>false</attach>
                  <stripDebug>true</stripDebug>
                  <noHeaderFiles>true</noHeaderFiles>
                  <noManPages>true</noManPages>
                  <compress>zip-6</compress>
                  <outputDirectoryImage
                                    >${project.build.directory}/maven-jlink</outputDirectoryImage>
                  <includeLocales>
                    <includeLocale>en</includeLocale>
                    <includeLocale>fr</includeLocale>
                  </includeLocales>
                  <addModules>
                    <addModule>fr.cnrs.lacito.liftgui</addModule>
                    <addModule>jdk.localedata</addModule>
                  </addModules>
                  <launchers>
                    <launcher
                                        >${app.jpackage.name}=fr.cnrs.lacito.liftgui/fr.cnrs.lacito.liftgui.MainApp</launcher>
                  </launchers>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <configuration>
              <name>${app.jpackage.name}</name>
              <appVersion>1.0.0</appVersion>
              <vendor>CNRS LACITO</vendor>
              <icon>${jpackage.icon}</icon>
              <destination
                            >${project.build.directory}/jpackage${jpackage.destSuffix}</destination>
              <removeDestination>true</removeDestination>
              <module
                            >fr.cnrs.lacito.liftgui/fr.cnrs.lacito.liftgui.MainApp</module>
              <runtimeImage
                            >${project.build.directory}/maven-jlink/default</runtimeImage>
              <type>${jpackage.type}</type>
              <winMenu>true</winMenu>
              <winMenuGroup>${app.jpackage.name}</winMenuGroup>
              <linuxShortcut>true</linuxShortcut>
              <linuxMenuGroup>${app.jpackage.name}</linuxMenuGroup>
              <linuxAppCategory>Office</linuxAppCategory>
            </configuration>
            <executions>
              <execution>
                <id>jpackage-installer</id>
                <phase>package</phase>
                <goals>
                  <goal>jpackage</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
