<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           styleClass="loading-root"
           prefWidth="600" prefHeight="400">
  <VBox alignment="CENTER" spacing="20">
    <VBox alignment="CENTER" spacing="4">
      <Label text="DictionaryEditor" styleClass="loading-title"/>
      <ImageView fitWidth="200" fitHeight="200" preserveRatio="true" smooth="true">
        <image>
          <Image url="@icons/app/icon-512.png"/>
        </image>
      </ImageView>
    </VBox>
    <ProgressBar fx:id="progressBar" styleClass="loading-progress" prefWidth="380" prefHeight="6" progress="0"/>
  </VBox>
</StackPane>
